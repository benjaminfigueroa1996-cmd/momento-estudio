# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor, nunca en el navegador

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=momento-estudio

# Sesiones de anfitriones, fotógrafo y estaciones iPad (32+ bytes aleatorios)
SESSION_SECRET=
# Sal para anonimizar IPs en límites de solicitudes
IP_HASH_SALT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo transaccional (opcional; sin esto las cotizaciones solo quedan en el panel)
RESEND_API_KEY=
COMMERCIAL_EMAIL=
CRON_SECRET=                      # Vercel lo envía en las tareas programadas
